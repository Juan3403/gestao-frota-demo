#!/bin/sh
# Hook de pré-commit: bloqueia o commit se um segredo for detectado no que está no stage.
# Instalação (Linux/macOS):
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Para pular pontualmente (use com consciência):  git commit --no-verify
set -e
echo "[pre-commit] verificando segredos no stage…"
node scripts/scan-secrets.js --staged
echo "[pre-commit] ok."
